menu "A2DP to Dual BIS Example"

    config A2DP_BIS_DEVICE_NAME
        string "Bluetooth device / broadcast name"
        default "A2DP-2-BIS"

    config A2DP_BIS_BROADCAST_CODE
        string "Broadcast code (empty for open broadcast)"
        default ""

    choice A2DP_BIS_PCM_CVT
        prompt "PCM conversion path"
        default A2DP_BIS_PCM_CVT_ASRC if SOC_ASRC_SUPPORTED
        default A2DP_BIS_PCM_CVT_SW
        help
            Convert decoded A2DP PCM to the LC3 channel count and sample rate.
            Hardware ASRC is the default on chips that expose SOC_ASRC.
            Otherwise the software channel and rate converters are used.

        config A2DP_BIS_PCM_CVT_SW
            bool "Software channel converter + rate converter"
        config A2DP_BIS_PCM_CVT_ASRC
            bool "Hardware ASRC"
            depends on SOC_ASRC_SUPPORTED
    endchoice

    choice A2DP_BIS_LC3_PRESET
        prompt "LC3 broadcast preset"
        default A2DP_BIS_LC3_PRESET_48KHZ_10MS_155B_HQ_MONO
        help
            Default is 48 kHz, 10 ms, 155-byte, high quality: one BIG and one BIS.
            16 kHz stereo uses one BIG and two BIS (front left / front right).
            Mono presets mix A2DP stereo down to one BIS.

        config A2DP_BIS_LC3_PRESET_16KHZ_10MS_40B_HQ
            bool "16 kHz / 10 ms / 40 B / HQ, stereo (1 BIG / 2 BIS)"
        config A2DP_BIS_LC3_PRESET_16KHZ_10MS_40B_HQ_MONO
            bool "16 kHz / 10 ms / 40 B / HQ, mono (1 BIG / 1 BIS)"
        config A2DP_BIS_LC3_PRESET_48KHZ_10MS_155B_HQ_MONO
            bool "48 kHz / 10 ms / 155 B / HQ, mono (1 BIG / 1 BIS)"
    endchoice

endmenu
